<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Microsoft 365 Engineering Console"
    Height="820" Width="1340"
    WindowStartupLocation="CenterScreen"
    Background="#FFF6F7F9">

  <Window.Resources>
    <SolidColorBrush x:Key="Accent"     Color="#FF2563EB"/>
    <SolidColorBrush x:Key="AccentDark" Color="#FF1D4ED8"/>
    <SolidColorBrush x:Key="Panel"      Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Border"     Color="#FFDDE1E6"/>
    <SolidColorBrush x:Key="Muted"      Color="#FF6B7280"/>

    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentDark}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="#FFB4BCC7"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#FF64748B"/>
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#FFDC2626"/>
    </Style>

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Resources>

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- connection bar -->
      <RowDefinition Height="*"/>      <!-- main -->
      <RowDefinition Height="Auto"/>   <!-- status bar -->
    </Grid.RowDefinitions>

    <!-- ================= Connection bar ================= -->
    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
            BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="ConnDot" Width="11" Height="11" Fill="#FFDC2626" Margin="0,0,8,0"/>
          <TextBlock x:Name="ConnText" Text="Not connected" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="ConnDetail" Style="{StaticResource Sub}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button x:Name="BtnConnect" Content="Connect"/>
          <Button x:Name="BtnDisconnect" Content="Disconnect" Style="{StaticResource Secondary}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= Main body ================= -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Task catalog -->
      <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
              BorderThickness="1" CornerRadius="6" Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="Task catalog" Style="{StaticResource H1}" Margin="0,0,0,8"/>

          <TextBox x:Name="TxtSearch" Grid.Row="1" Padding="6" Margin="0,0,0,6"
                   BorderBrush="{StaticResource Border}" ToolTip="Filter by name, synopsis or the original script it replaces"/>

          <ComboBox x:Name="CmbCategory" Grid.Row="2" Padding="6" Margin="0,0,0,8"
                    BorderBrush="{StaticResource Border}"/>

          <TreeView x:Name="TreeTasks" Grid.Row="3" BorderThickness="0" Background="Transparent"/>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

      <!-- Detail + results -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Task detail -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
              <TextBlock x:Name="LblTaskName" Text="Select a task" Style="{StaticResource H1}"/>
              <Border x:Name="RiskBadge" CornerRadius="3" Padding="7,2" Margin="10,1,0,0"
                      Background="#FF10B981" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock x:Name="LblRisk" Text="ReadOnly" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
              </Border>
            </StackPanel>

            <TextBlock x:Name="LblSynopsis" Grid.Row="1" Style="{StaticResource Sub}" Margin="0,5,0,0"/>
            <TextBlock x:Name="LblReplaces" Grid.Row="2" Style="{StaticResource Sub}" Margin="0,5,0,0"
                       FontStyle="Italic" Visibility="Collapsed"/>
            <TextBlock x:Name="LblScopes"   Grid.Row="3" Style="{StaticResource Sub}" Margin="0,5,0,0"/>

            <!-- Parameters + run -->
            <Grid Grid.Row="4" Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <ScrollViewer Grid.Column="0" MaxHeight="210" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PanelParams"/>
              </ScrollViewer>

              <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="14,0,0,0">
                <Button x:Name="BtnRun" Content="Run task" IsEnabled="False" MinWidth="120"/>
                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource Danger}"
                        IsEnabled="False" MinWidth="120" Margin="0,6,8,0"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>

        <!-- Results / log -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="6" Padding="10">
          <TabControl x:Name="TabsOutput" BorderThickness="0" Background="Transparent">
            <TabItem Header="Results">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,6,0,8">
                  <TextBlock x:Name="LblRowCount" Text="No results" VerticalAlignment="Center"
                             Margin="0,0,16,0" Style="{StaticResource Sub}"/>
                  <Button x:Name="BtnExportCsv"  Content="Export CSV"  Style="{StaticResource Secondary}" IsEnabled="False"/>
                  <Button x:Name="BtnExportHtml" Content="Export HTML" Style="{StaticResource Secondary}" IsEnabled="False"/>
                  <Button x:Name="BtnCopy"       Content="Copy to clipboard" Style="{StaticResource Secondary}" IsEnabled="False"/>
                </StackPanel>

                <DataGrid x:Name="GridResults" Grid.Row="1" AutoGenerateColumns="True"
                          IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          AlternatingRowBackground="#FFF8FAFC" RowBackground="White"
                          BorderBrush="{StaticResource Border}" BorderThickness="1"
                          FontSize="12" EnableRowVirtualization="True" EnableColumnVirtualization="True"/>
              </Grid>
            </TabItem>

            <TabItem Header="Activity log">
              <DataGrid x:Name="GridLog" AutoGenerateColumns="False" IsReadOnly="True"
                        GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                        AlternatingRowBackground="#FFF8FAFC" RowBackground="White"
                        BorderBrush="{StaticResource Border}" BorderThickness="1" FontSize="12">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Time"    Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" Width="80"/>
                  <DataGridTextColumn Header="Level"   Binding="{Binding Level}"   Width="80"/>
                  <DataGridTextColumn Header="Source"  Binding="{Binding Source}"  Width="180"/>
                  <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
          </TabControl>
        </Border>
      </Grid>
    </Grid>

    <!-- ================= Status bar ================= -->
    <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
            BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,10,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="LblStatus" Grid.Column="0" Text="Ready" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
        <ProgressBar x:Name="Progress" Grid.Column="1" Width="190" Height="10"
                     IsIndeterminate="False" Visibility="Hidden"/>
      </Grid>
    </Border>
  </Grid>
</Window>
